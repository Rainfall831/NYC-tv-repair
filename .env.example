# Optional override for canonical URLs, sitemap, and PayPal return URL.
# On Vercel, leave unset — production uses VERCEL_PROJECT_PRODUCTION_URL; previews use VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=

# Booking form email delivery (https://resend.com). Without a key:
#  - in development, requests are logged to the server console and the form succeeds;
#  - in production, the form shows an error asking the customer to call.
RESEND_API_KEY=
# Where booking requests are sent. Defaults to nytvrepair@optonline.net.
BOOKING_TO_EMAIL=nytvrepair@optonline.net
# Verified sender address in your Resend account.
BOOKING_FROM_EMAIL="NY Tech Booking <booking@nytechtvrepair.com>"
